export const mode: 'tous' | 'ateliers' = 'tous';

export const placesRestantes = (e: Evenement): number => {
  const r = e.capacite - e.inscrits;
  return r > 0 ? r : 0;
};

export const statutEvenement = (e: Evenement): string => {
  const r = placesRestantes(e);
  if (r === 0) return 'Complet';
  if (r <= 3) return 'Presque complet';
  return 'Ouvert';
};
